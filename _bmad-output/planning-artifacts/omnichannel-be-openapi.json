 Outbox Pattern\n- Read/Write separation (CQRS)\n- Request correlation for distributed tracing\n- Rate limiting and validation\n\n## Authentication\nCurrently, this demo API does not require authentication.\nIn production, add Bearer token authentication.\n    ","version":"1.0","contact":{}},"tags":[{"name":"products","description":"Product management endpoints"},{"name":"orders","description":"Order management endpoints"},{"name":"health","description":"Health check endpoints"}],"servers":[],"components":{"securitySchemes":{"JWT-auth":{"scheme":"bearer","bearerFormat":"JWT","type":"http","description":"Enter JWT token"},"Idempotency-Key":{"type":"apiKey","in":"header","name":"X-Idempotency-Key","description":"Idempotency key for safe retries"},"Correlation-Id":{"type":"apiKey","in":"header","name":"X-Correlation-Id","description":"Correlation ID for distributed tracing"}},"schemas":{"InboundMessageDto":{"type":"object","properties":{}},"ReplyDto":{"type":"object","properties":{}},"CreateTicketDto":{"type":"object","properties":{}},"UpdatePresenceDto":{"type":"object","properties":{}},"CloseConversationDto":{"type":"object","properties":{}},"ClassifyImageDto":{"type":"object","properties":{}},"TranscribeAudioDto":{"type":"object","properties":{}},"ClassifyIntentDto":{"type":"object","properties":{}},"DispatchWorkOrderDto":{"type":"object","properties":{}},"SubmitCsatDto":{"type":"object","properties":{}},"AdvanceStageDto":{"type":"object","properties":{}}}}}