# Service Configuration
PORT=3000
NODE_ENV=development
SERVICE_NAME=nestjs-ddd-api
SERVICE_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_project
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_project

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Observability
LOG_LEVEL=debug
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_PORT=9464

# Security
JWT_SECRET=super-secret-key-change-me-in-production
# HMAC secret cho /webhooks/* (WebhookHmacGuard, fail-closed). PHẢI trùng giá trị
# CSKH_WEBHOOK_HMAC_SECRET của app-tu-phuc-vu. Unset => mọi /webhooks/* trả 403.
WEBHOOK_HMAC_SECRET=
RATE_LIMIT_REDIS_URL=redis://localhost:6379

# Notification (gRPC Send → notification-be-rs; empty NOTIFICATION_GRPC_URL = mock/fallback)
NOTIFICATION_GRPC_URL=
NOTIFICATION_TENANT_ID=tnt_hawaco
# Keycloak SA (client_credentials) — empty = no auth (dev với notification-be-rs AUTH_ENABLED=false)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=water-platform
KEYCLOAK_SA_CLIENT_ID=
KEYCLOAK_SA_CLIENT_SECRET=

# Customer 360 (.NET water-business-cskh-bff base URL; empty = Mock adapter)
CSKH_BFF_URL=
AMQP_URL=amqp://omnichannel:omnichannel@localhost:5672
